# Copy to .env and fill in only what you need. Every variable is optional;
# no research lane needs an API key. Never commit your .env.

# Default market for config-driven tools
MOONFACE_EXCHANGE=binance
MOONFACE_SYMBOL=BTC/USDT:USDT

# moonface-feed: posting is off unless --post or MOONFACE_FEED_POST=1
MOONFACE_FEED_POST=
MOONFACE_FEED_TELEGRAM_TOKEN=
MOONFACE_FEED_CHAT_ID=

# Generic Telegram notifier (feed --watch alerts). Set BOTH to enable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
